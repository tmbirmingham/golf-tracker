FLASK_ENV=development
# Required. Signs session cookies and form tokens. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me

# Local development over plain http needs this off; leave it unset (on) in production.
SESSION_COOKIE_SECURE=0

# Mailjet send API (HTTPS). Get the API key + secret from
# https://app.mailjet.com/account/api_credentials
MAILJET_SMTP_USERNAME=your_mailjet_api_key
MAILJET_SMTP_PASSWORD=your_mailjet_secret_key
MAIL_FROM_EMAIL=your_verified_sender@example.com

# Email abuse limits (defaults shown)
# EMAIL_LIMIT_PER_ROUND=2
# EMAIL_LIMIT_PER_CLIENT_HOUR=5
# EMAIL_LIMIT_PER_DAY=50

# SQLite database for course data and saved rounds (optional; default instance/golf_tracker.db).
# DATABASE_PATH=/var/data/golf_tracker.db

# Optional: back up saved rounds to a file in a PRIVATE GitHub repository, so they
# survive redeploys. Use a fine-grained token limited to that one repository with
# "Contents: read and write". Don't point this at the app's own repo/branch.
# BACKUP_GITHUB_TOKEN=github_pat_...
# BACKUP_GITHUB_REPO=your-user/golf-tracker-data
# BACKUP_GITHUB_BRANCH=main
# BACKUP_GITHUB_PATH=golf-tracker/rounds.json

# Set to 0 if the app is NOT behind a single reverse proxy (Render adds one).
# TRUST_PROXY=1
